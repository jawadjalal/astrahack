# Copy to the ignored .env and fill in the values needed by your workstream:  cp .env.example .env
# Root npm scripts and scripts/*.mjs load .env (then .env.local) for you; real shell variables win.
# Run `npm run doctor` to see what is missing (it never prints secrets). Never commit real credentials.
# Nothing here is needed for `npm run teardown -- --mock`.

# Where scripts draw. Local canvas: http://localhost:3000 (npm run canvas). Shared, Blob-backed board:
# https://ignura.com/astrahack (base paths work, no trailing slash). The URL-first worker (npm run worker)
# needs the shared one. Scripts never clear a remote board unless you pass --clear.
CANVAS_URL=http://localhost:3000
# Match the random secret configured on the deployed canvas server (24+ characters).
ASTRAHACK_WORKER_TOKEN=

# Chrome is auto-detected (macOS/Linux/Windows install paths, Playwright cache): leave empty unless the doctor
# says no Chrome was found. Set it to pin a browser. Video also needs ffmpeg on PATH (or ASTRAHACK_FFMPEG).
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
ASTRAHACK_CHROME=
ASTRAHACK_FFMPEG=
# Optional custom agent for `npm run teardown` ({url} {out} {canvas} are substituted; it must leave
# report.json or qa-agent.json in {out}), e.g.  node agent/run.mjs {url} --out {out} --canvas {canvas}
ASTRAHACK_AGENT_CMD=

# Computer-use QA, analysis, and feature capture.
OPENAI_API_KEY=
OPENAI_QA_MODEL=gpt-6-luna
OPENAI_SCREENSHOT_MODEL=gpt-6-luna
OPENAI_QA_ANALYSIS_MODEL=gpt-6-luna

# Marketing generators.
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TEXT_MODEL=gemini-3.5-flash
OPENAI_IMAGE_MODEL=gpt-image-2

# Canvas host only (canvas/.env.local or deployment settings):
# NEXT_PUBLIC_BASE_PATH=/astrahack
# CANVAS_STORE=blob
# BLOB_READ_WRITE_TOKEN=...
# ASTRAHACK_WORKER_TOKEN=... (same secret as the local worker)
# See docs/WEB_RUNS.md for setup and optional private job storage.

# Teardown agent in agent/ (docs/AGENT.md). Needs OPENAI_API_KEY above unless run with --mock.
ASTRA_MODEL=gpt-6-astra
# reasoning effort: low | medium | high | xhigh | max
ASTRA_REASONING=low
# Steering/status server of a running agent (curl localhost:7788/steer -d '{"text":"..."}'); `--port off` disables
AGENT_PORT=7788
# Throwaway test identity. The agent types {{TEST_EMAIL}} etc. and the harness substitutes these, so the
# model, logs, reports and canvas never see them. Never put real accounts here.
AGENT_TEST_EMAIL=
AGENT_TEST_PASSWORD=
AGENT_TEST_NAME=
AGENT_TEST_PHONE=
# Extra STOP file path that ends a run when it appears (agent/STOP and <run dir>/STOP always work)
AGENT_STOP_FILE=
