# AstraHack environment. Copy to `.env` (git-ignored) and fill in only what you need:
#   cp .env.example .env
# Root npm scripts and scripts/*.mjs load `.env` automatically (and `.env.local` on top).
# Real shell variables always win over the file. Nothing here is needed for `npm run teardown -- --mock`.
# Run `npm run doctor` to see what is missing. Never commit real keys. The doctor never prints them.

# ---------------------------------------------------------------------------------------
# Canvas
# ---------------------------------------------------------------------------------------
# Where scripts draw. Local canvas: http://localhost:3000 (cd canvas && npm run dev).
# Deployed (Blob-backed, shared): https://ignura.com/astrahack  (base paths work, no trailing slash)
CANVAS_URL=http://localhost:3000

# Canvas app server only (canvas/.env.local or the Vercel project, not read by the CLIs):
#   CANVAS_STORE=blob                 use the Vercel Blob op log instead of memory (set on Vercel)
#   NEXT_PUBLIC_BASE_PATH=/astrahack  serve under a base path (set on Vercel; empty locally)
#   BLOB_READ_WRITE_TOKEN=...         created by Vercel when the Blob store is linked to the project

# ---------------------------------------------------------------------------------------
# Computer use (runner, QA crawl/agent/fleet, feature capture)
# ---------------------------------------------------------------------------------------
# Chrome or Chromium. Optional: found automatically on macOS/Linux/Windows, including a Playwright
# cache. Set it when the doctor says "no Chrome found" or you want a specific browser.
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
ASTRAHACK_CHROME=
# ffmpeg is optional; only needed for journey recordings ("video": true). Found on PATH when unset.
ASTRAHACK_FFMPEG=

# OpenAI key for the model-driven agent (GPT-6 Astra computer use): `npm run qa -- agent|fleet`,
# QA analysis, feature capture. The model name `gpt-6-astra` is set in the config JSON (examples/qa.json).
# Also used for ad images when IMAGE_PROVIDER=openai.
OPENAI_API_KEY=

# Optional: a custom agent command for teardown.mjs (for the autonomous agent in agent/).
# {url} {out} {canvas} are substituted. It must leave report.json or qa-agent.json in {out}.
#   ASTRAHACK_AGENT_CMD=node agent/run.mjs {url} --out {out}
ASTRAHACK_AGENT_CMD=

# ---------------------------------------------------------------------------------------
# Marketing generators (generate.mjs ad creatives, campaigns.mjs X/Reddit)
# ---------------------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/api-keys (image generation needs model access and quota)
GEMINI_API_KEY=
IMAGE_PROVIDER=gemini                     # gemini | openai
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1 # Nano Banana, 5 square 1024x1024 PNGs
GEMINI_TEXT_MODEL=gemini-2.5-flash        # campaigns.mjs text model
OPENAI_IMAGE_MODEL=gpt-image-2            # used only with IMAGE_PROVIDER=openai
