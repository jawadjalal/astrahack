{
  "name": "astrahack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "bin": {
    "astrahack": "./bin/astrahack.js",
    "astrahack-qa": "./bin/qa.js"
  },
  "scripts": {
    "run": "node bin/astrahack.js",
    "qa": "node bin/qa.js",
    "capture-features": "node bin/feature-capture.js",
    "generate": "node --env-file-if-exists=.env generate.mjs",
    "test": "node --test test/*.test.js test/*.test.mjs agent/test/*.test.mjs",
    "check": "node --check generate.mjs && node --check lib/generate.mjs && node --check campaigns.mjs && node --check lib/campaigns.mjs",
    "campaigns": "node --env-file-if-exists=.env campaigns.mjs",
    "worker": "node bin/web-worker.js"
  }
}
